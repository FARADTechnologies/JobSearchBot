JOBSEARCH_BASE_URL=https://jobsearch.az
JOBSEARCH_LIST_URL=https://jobsearch.az/vacancies

# Telegram BotFather-dan aldigin token.
TELEGRAM_BOT_TOKEN=

# Mesaj gonderilecek chat id.
# Kendi chat id-ni tapmaq ucun botuna mesaj yaz, sonra:
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Bos qalarsa bot sadece keyword/heuristic filtresi ile calisar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# HIGH_MATCH her zaman gonderilir. MAYBE_MATCH gondermek istemiyorsansa false yaz.
SEND_MAYBE_MATCHES=true

# Her calismada en fazla kac aday ilanin detayina bakilsin.
MAX_JOBS_PER_RUN=150

# Botun gordugu ilanlari kaydettigi dosya.
SEEN_DB_PATH=data/seen_jobs.json
