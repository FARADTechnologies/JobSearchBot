JOBSEARCH_BASE_URL=https://jobsearch.az
JOBSEARCH_LIST_URL=https://jobsearch.az/vacancies

# Telegram token from BotFather.
TELEGRAM_BOT_TOKEN=

# Chat id to send messages to.
# To find your own chat id, message your bot, then open:
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# If empty, the bot runs on the keyword/heuristic filter only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# HIGH_MATCH is always sent. Set to false if you do not want MAYBE_MATCH sent.
SEND_MAYBE_MATCHES=true

# Max number of candidate listings to inspect in detail per run.
MAX_JOBS_PER_RUN=150

# File where the bot records the listings it has seen.
SEEN_DB_PATH=data/seen_jobs.json

# --- Phase 1: multi-user (Supabase) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# CV profile extraction (Groq - does not train on the data). If empty, heuristic is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Max number of listing details fetched and cached per run (multi-user flow).
ENRICH_BUDGET_PER_RUN=60

# --- Global remote track (personal feature) ---
# Separate Telegram group/channel for remote jobs. Falls back to TELEGRAM_CHAT_ID if empty.
REMOTE_TELEGRAM_CHAT_ID=
REMOTE_TRACK_ENABLED=true
REMOTE_MAX_PER_RUN=25
REMOTE_MIN_SALARY=0
REMOTE_DIGEST=false

# Pool expansion: Adzuna aggregator (free instant key at developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LLM judge for the remote track (Gemini). Job listings are public data, so a free tier is fine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
LLM_JUDGE_ENABLED=true
LLM_JUDGE_MAX=100
